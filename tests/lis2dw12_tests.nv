    c.regs.insert(0x30, 0x0B)
    test.assert(lis2dw12.orientation_config(d, true, 2))
    test.assert_eq(reg_of(c, 0x30), 0xCB)
    test.assert(lis2dw12.orientation_config(d, false, 9))
    test.assert_eq(reg_of(c, 0x30), 0x6B)

@test
fn test_the_source_registers_are_read_whole() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x39, 0x66)
    c.regs.insert(0x38, 0x17)
    c.regs.insert(0x3A, 0x42)
    c.regs.insert(0x3B, 0x2D)
    test.assert_eq(lis2dw12.tap_source(d), 0x66)
    test.assert_eq(lis2dw12.wake_up_source(d), 0x17)
    test.assert_eq(lis2dw12.orientation_source(d), 0x42)
    test.assert_eq(lis2dw12.event_source(d), 0x2D)
    c.st.insert(4, 0)
    test.assert_eq(lis2dw12.tap_source(d), 0)
    test.assert_eq(lis2dw12.event_source(d), 0)

// ── Bring-up ─────────────────────────────────────────────────────────

@test
fn test_the_bring_up_resets_the_part_then_writes_its_settings_with_ctrl1_last() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x20, 0xFF)
    c.regs.insert(0x25, 0xFF)
    test.assert(d.setup())
    test.assert(lis2dw12.start(d))
    // The soft reset, then CTRL2 (BDU and the increment), CTRL3, INT1 on
    // data-ready, INT2 off, CTRL6, CTRL7, the FIFO in bypass, and last CTRL1:
    // 100 Hz, High-Performance Mode.
    writes_are(c, [0x21,
        0x40,
        0x21,
        0x0C,
        0x22,
        0x00,
        0x23,
        0x01,
        0x24,
        0x00,
        0x25,
        0x00,
        0x3F,
        0x00,
        0x2E,
        0x00,
        0x20,
        0x54])
    test.assert_eq(reg_of(c, 0x20), 0x54)
    test.assert_eq(reg_of(c, 0x25), 0x00)

@test
fn test_the_bring_up_over_spi_runs_the_same_settings() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert(lis2dw12.start(d))
    writes_are(c, [0x21,
        0x40,
        0x21,
        0x0C,
        0x22,
        0x00,
        0x23,
        0x01,
        0x24,
        0x00,
        0x25,
        0x00,
        0x3F,
        0x00,
        0x2E,
        0x00,
        0x20,
        0x54])

@test
fn test_the_bring_up_waits_for_the_reset_bit_to_clear_by_polling_it() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.st.insert(41, 5)
    test.assert(lis2dw12.start(d))
    test.assert_eq(reg_of(c, 0x20), 0x54)

@test
fn test_a_reset_bit_that_never_clears_ends_the_bring_up() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.st.insert(41, -1)
    test.assert(not lis2dw12.start(d))
    test.assert(not lis2dw12.soft_reset(d))
    test.assert_eq(reg_of(c, 0x20), 0x00)

@test
fn test_a_part_that_is_not_a_lis2dw12_is_refused() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x0F, 0x33)
    test.assert(not lis2dw12.start(d))
    test.assert_eq(at(c.st, 80), 0)
    let c2 = chip()
    c2.st.insert(4, 0)
    test.assert(not lis2dw12.start(i2c_dut(c2)))
    test.assert(not lis2dw12.start(spi_dut(c2)))

@test
fn test_a_wiring_the_bus_cannot_use_is_refused_before_anything_is_sent() [io, hw]
    let c = chip()
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    test.assert(not lis2dw12.start(I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: w }))
    log_is(c, [])

@test
fn test_a_part_that_refuses_a_setting_ends_the_bring_up() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.ro.insert(0x20, 1)
    test.assert(not lis2dw12.start(d))
    let c2 = chip()
    c2.ro.insert(0x23, 1)
    test.assert(not lis2dw12.start(i2c_dut(c2)))
    // A part that dies right after the reset.
    let c3 = chip()
    c3.st.insert(70, 3)
    test.assert(not lis2dw12.start(i2c_dut(c3)))
    let c4 = chip()
    c4.st.insert(70, 1)
    test.assert(not lis2dw12.start(i2c_dut(c4)))

@test
fn test_the_reboot_sets_boot_keeping_the_other_bits_and_waits_for_it_to_clear() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x21, 0x0C)
    c.st.insert(41, 3)
    test.assert(lis2dw12.reboot(d))
    writes_are(c, [0x21, 0x8C])
    test.assert_eq(reg_of(c, 0x21), 0x0C)
    c.st.insert(41, -1)
    test.assert(not lis2dw12.reboot(d))
    c.st.insert(4, 0)
    test.assert(not lis2dw12.reboot(d))
    let c2 = chip()
    c2.st.insert(70, 1)
    test.assert(not lis2dw12.reboot(i2c_dut(c2)))

// ── The two types ────────────────────────────────────────────────────
//
// The types are built over the host's board handles, which answer as absent
// hardware here: each method answers its "no part" value.  This runs the
// lines of the two types that forward to the functions above.

@test
fn test_the_i2c_type_over_absent_hardware() [io, hw]
    let w = dev_bus.wiring_i2c(0, 0x18)
    let p = Lis2dw12.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, w)
    test.assert(not p.begin())
    test.assert(p.reg(0x0F) == None)
    test.assert(not p.set_reg(0x20, 1))
    test.assert(p.mode() == Lis2dwMode.Lis2dwLowPower)
    test.assert_eq(p.lp_level(), 1)
    test.assert_eq(p.resolution(), 12)
    test.assert(not p.set_mode(Lis2dwMode.Lis2dwHighPerf, 1))
    test.assert(not p.fifo_begin(10))
    test.assert(not p.fifo_end())
    test.assert(p.convert() == None)
    test.assert(p.self_test(false) == None)
    test.assert_eq(p.irq_level(), -1)
    test.assert(p.accel_read() == None)
    test.assert(not p.accel_ready())
    test.assert(p.accel_range() == AccelRange.AccelRange2g)
    test.assert(not p.accel_set_range(AccelRange.AccelRange4g))
    test.assert_eq(p.accel_rate_hz(), 0)
    test.assert_eq(p.accel_set_rate_hz(100), 0)
    test.assert_eq(p.accel_fifo_count(), 0)
    var out: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(p.accel_fifo_read(var out), 0)
    test.assert_eq(p.temp_start(), -1)
    test.assert(p.temp_read() == None)
    test.assert(p.device_id() == None)

@test
fn test_the_spi_type_over_absent_hardware() [io, hw]
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    let p = Lis2dw12Spi.attach(BoardSpi { id: 0 }, BoardGpio { id: 0 }, w)
    test.assert(not p.begin())
    test.assert(p.reg(0x0F) == None)
    test.assert(not p.set_reg(0x20, 1))
    test.assert(p.mode() == Lis2dwMode.Lis2dwLowPower)
    test.assert_eq(p.lp_level(), 1)
    test.assert_eq(p.resolution(), 12)
    test.assert(not p.set_mode(Lis2dwMode.Lis2dwHighPerf, 1))
    test.assert(not p.fifo_begin(10))
    test.assert(not p.fifo_end())
    test.assert(p.convert() == None)
    test.assert(p.self_test(true) == None)
    test.assert_eq(p.irq_level(), -1)
    test.assert(p.accel_read() == None)
    test.assert(not p.accel_ready())
    test.assert(p.accel_range() == AccelRange.AccelRange2g)
    test.assert(not p.accel_set_range(AccelRange.AccelRange4g))
    test.assert_eq(p.accel_rate_hz(), 0)
    test.assert_eq(p.accel_set_rate_hz(100), 0)
    test.assert_eq(p.accel_fifo_count(), 0)
    var out: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(p.accel_fifo_read(var out), 0)
    test.assert_eq(p.temp_start(), -1)
    test.assert(p.temp_read() == None)
    test.assert(p.device_id() == None)

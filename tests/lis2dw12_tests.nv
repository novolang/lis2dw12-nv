    test.assert_eq(reg_of(c, 0x36), 0x2B)
    test.assert_eq(reg_of(c, 0x35), 0x7F)
    test.assert(lis2dw12.free_fall_config(d, 9, 63))
    test.assert_eq(reg_of(c, 0x36), 0xFF)
    test.assert_eq(reg_of(c, 0x35), 0xFF)
    test.assert(lis2dw12.free_fall_config(d, 0, 0))
    test.assert_eq(reg_of(c, 0x36), 0x00)
    test.assert_eq(reg_of(c, 0x35), 0x7F)

@test
fn test_the_orientation_config_sets_4d_and_the_angle_keeping_the_tap_threshold() [io, hw]

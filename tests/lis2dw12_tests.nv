    test.assert_eq(lis2dw12.free_fall_lsb(2), 8)
    test.assert_eq(lis2dw12.free_fall_lsb(3), 10)
    test.assert_eq(lis2dw12.free_fall_lsb(4), 11)
    test.assert_eq(lis2dw12.free_fall_lsb(5), 13)
    test.assert_eq(lis2dw12.free_fall_lsb(6), 15)
    test.assert_eq(lis2dw12.free_fall_lsb(7), 16)
    test.assert_eq(lis2dw12.free_fall_lsb(9), 16)
    test.assert_eq(lis2dw12.free_fall_lsb(-1), 5)

@test
fn test_the_free_fall_duration_is_six_bits_over_two_registers() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x35, 0x7F)

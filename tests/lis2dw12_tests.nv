    c.regs.insert(0x35, 0xE0)
    test.assert(lis2dw12.activity_config(d, true, true, 5))
    test.assert_eq(reg_of(c, 0x34), 0xCA)
    test.assert_eq(reg_of(c, 0x35), 0xF5)
    test.assert(lis2dw12.activity_config(d, false, false, 99))
    test.assert_eq(reg_of(c, 0x34), 0x8A)
    test.assert_eq(reg_of(c, 0x35), 0xEF)

@tier(app)
fn tap(thr: Int) -> TapConfig
    TapConfig { thr_x: thr,
        thr_y: thr + 1,
        thr_z: thr + 2,
        prior: 3,
        x_en: true,
        y_en: false,
        z_en: true,
        double_tap: true,
        latency: 5,
        quiet: 2,
        shock: 1 }

@test
fn test_the_tap_config_writes_the_thresholds_the_axes_the_timing_and_the_double_bit() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x30, 0xE0)
    c.regs.insert(0x34, 0x3F)
    test.assert(lis2dw12.tap_config(d, tap(8)))
    // X keeps its 4D and 6D bits; Y is the priority and the threshold; Z is
    // the axis enables and the threshold; the timing; the double-tap bit.
    test.assert_eq(reg_of(c, 0x30), 0xE8)
    test.assert_eq(reg_of(c, 0x31), 0x69)
    test.assert_eq(reg_of(c, 0x32), 0xAA)
    test.assert_eq(reg_of(c, 0x33), 0x59)
    test.assert_eq(reg_of(c, 0x34), 0xBF)
    let single = TapConfig { thr_x: 40,
        thr_y: -3,
        thr_z: 7,
        prior: 12,
        x_en: false,
        y_en: true,
        z_en: false,
        double_tap: false,
        latency: 99,
        quiet: 9,
        shock: 9 }
    test.assert(lis2dw12.tap_config(d, single))
    test.assert_eq(reg_of(c, 0x30), 0xFF)
    test.assert_eq(reg_of(c, 0x31), 0xE0)
    test.assert_eq(reg_of(c, 0x32), 0x47)
    test.assert_eq(reg_of(c, 0x33), 0xFF)
    test.assert_eq(reg_of(c, 0x34), 0x3F)

@test
fn test_the_tap_config_stops_at_the_first_register_the_part_refuses() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.ro.insert(0x32, 1)
    test.assert(not lis2dw12.tap_config(d, tap(8)))
    test.assert_eq(reg_of(c, 0x33), 0)


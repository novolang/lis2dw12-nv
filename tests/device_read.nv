// device_read — a reading loop for a LIS2DW12 on a breakout, for an nRF52840
// DK or an nRF54LM20 DK.
//
// The breakout's SDA and SCL go to the board's I2C pins and its SDO/SA0
// pin to ground, which puts the part at 0x18; its CS pin goes to the supply,
// which selects I2C; INT1 goes to a free GPIO, if the program is to read the
// data-ready line.  The program waits 20 ms for the part to turn on (the
// data sheet states no figure), brings it up at ±2 g in High-Performance
// Mode at 100 Hz, and prints one line per sample over RTT:
//
//     lis2dw12 x=<milli-g> y=<milli-g> z=<milli-g> t=<milli-degrees>
//
// With the board flat and face up, z is close to 1000.
//
// Build it with `novo build --target=nrf52840-dk tests/device_read.nv` or
// `novo build --target=nrf54lm20-dk tests/device_read.nv`.

use embedded_hal.{ BoardI2c, BoardGpio }
use dev_bus
use dev_accel.{ AccelMilliG, Accelerometer }
use dev_thermo.{ TempMilliC, Thermometer }
use lis2dw12
use lis2dw12.{ Lis2dw12 }

// The part's address with the SA0 pin low.
const ADDR = 0x18

// A label and a number, written without building a string.
fn field(label: Str, v: Int) [hw]
    hal.uart.write(label)
    hal.uart.write(str.from_int(v))

@tier(embedded)
fn main() [hw]
    let part = Lis2dw12.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, dev_bus.wiring_i2c(0, ADDR))
    hal.timer.delay_ms(20)
    if not part.begin()
        hal.uart.write("lis2dw12: no answer\n")
        return
    loop
        match part.accel_read_new()
            Some(a) =>
                hal.uart.write("lis2dw12")
                field(" x=", a.x)
                field(" y=", a.y)
                field(" z=", a.z)
                match part.temp_read()
                    Some(t) => field(" t=", t.milli_c)
                    None    => hal.uart.write(" t=?")
                hal.uart.write("\n")
            None    =>
                hal.timer.delay_ms(2)

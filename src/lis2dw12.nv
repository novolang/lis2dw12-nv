// lis2dw12 — ST's LIS2DW12 three-axis accelerometer, on its I2C or its SPI
// bus, as devices-nv's `Accelerometer`, `Thermometer` and `Identifiable`.
//
// The facts below are from ST's data sheet "LIS2DW12: MEMS digital output
// motion sensor: high-performance ultra-low-power 3-axis femto
// accelerometer", DS11811 Rev 8, July 2019 (the copy that could be
// fetched; its tables and sections are named by number).  The brief for this
// package named the data sheet DS11445 and application note AN5038; DS11445
// is not the LIS2DW12's number in any copy found, and AN5038 could not be
// fetched, so the tap and free-fall thresholds stay in the data sheet's own
// units and no value is taken from the note.  Where the sheet and the
// drivers read for this one disagree, the site says which was taken.
//
// The register map (§ 7, Table 21), as this driver uses it:
//
//   0x0D  OUT_T_L        temperature, 12 bits left-justified, 16 LSB/°C
//   0x0E  OUT_T_H
//   0x0F  WHO_AM_I       0x44
//   0x20  CTRL1          ODR (7:4), MODE (3:2), LP_MODE (1:0)
//   0x21  CTRL2          BOOT (7), SOFT_RESET (6), CS_PU_DISC (4), BDU (3),
//                        IF_ADD_INC (2), I2C_DISABLE (1), SIM (0)
//   0x22  CTRL3          ST2 (7), ST1 (6), PP_OD (5), LIR (4), H_LACTIVE
//                        (3), SLP_MODE_SEL (1), SLP_MODE_1 (0)
//   0x23  CTRL4_INT1_PAD_CTRL   the events routed to INT1
//   0x24  CTRL5_INT2_PAD_CTRL   the events routed to INT2
//   0x25  CTRL6          BW_FILT (7:6), FS (5:4), FDS (3), LOW_NOISE (2)
//   0x27  STATUS         DRDY (0) and the event flags
//   0x28  OUT_X_L to 0x2D OUT_Z_H: each axis a 16-bit two's complement
//         word, low byte first, left-justified
//   0x2E  FIFO_CTRL      FMode (7:5), FTH (4:0)
//   0x2F  FIFO_SAMPLES   FIFO_FTH (7), FIFO_OVR (6), Diff (5:0)
//   0x30 to 0x3B         the tap, wake-up, free-fall and 6D registers
//   0x3F  CTRL7          DRDY_PULSED (7), INTERRUPTS_ENABLE (5)
//
// The resolution and the step.  The words are left-justified (§ 8.12): in
// the 14-bit modes the valid bits are 15 to 2, in Low-Power Mode 1 they are
// 15 to 4 and bits 3 and 2 read 0.  Table 3's sensitivity is 0.244, 0.488,
// 0.976 and 1.952 mg per digit at ±2, ±4, ±8 and ±16 g in every mode except
// Low-Power Mode 1, where it is four times as much.  A reading is therefore
// 14 bits in High-Performance Mode and in Low-Power Modes 2 to 4, and 12
// bits in Low-Power Mode 1, and `bits_of_ctrl1` says which.  In the
// single-conversion mode LP_MODE selects the width the same way.
//
// The two buses.  On I2C the part answers at 0x18 (SA0 low) or 0x19 (SA0
// high), and the address increments after each byte of a burst only while
// CTRL2's IF_ADD_INC is set, which is the reset value (§ 6.1.1).  Unlike
// its predecessors the sub-address has no increment bit of its own.  On SPI
// a transaction is a command byte, then data, inside one chip-select
// window: bit 7 is RW (1 reads) and bits 6 to 0 are the register (§ 6.2);
// there is no MS bit, so IF_ADD_INC decides whether a burst advances.  The
// part drives SDO on the falling edge of SPC and samples SDI on the rising
// edge with SPC idle high, which is SPI mode 3, up to 10 MHz (Table 6).  CS
// high selects I2C.  The 3-wire interface (CTRL2's SIM) is not implemented.
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/st/lis2dw12`, ST's `lis2dw12-pid` and the `lis2dw12`
// crate 0.1.3.  Each fix kept is named at its site.
//
// The driver holds no state: the range, the mode and the width are read from
// the part in the same transaction as the sample.
//
// A bus enters through `Lis2dw12Port`, which a type that holds a bus
// implements: `Lis2dw12` for an I2C bus and `Lis2dw12Spi` for an SPI bus.
// The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over a
// double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut, TimerAsync, AsyncEdge }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, Accelerometer }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let OUT_T_L      = 0x0D
let WHO_AM_I     = 0x0F
let CTRL1        = 0x20
let CTRL2        = 0x21
let CTRL3        = 0x22
let CTRL4_INT1   = 0x23
let CTRL5_INT2   = 0x24
let CTRL6        = 0x25
let STATUS       = 0x27
let OUT_X_L      = 0x28
let FIFO_CTRL    = 0x2E
let FIFO_SAMPLES = 0x2F
let TAP_THS_X    = 0x30
let TAP_THS_Y    = 0x31
let TAP_THS_Z    = 0x32
let INT_DUR      = 0x33
let WAKE_UP_THS  = 0x34
let WAKE_UP_DUR  = 0x35
let FREE_FALL    = 0x36
let WAKE_UP_SRC  = 0x38
let TAP_SRC      = 0x39
let SIXD_SRC     = 0x3A
let ALL_INT_SRC  = 0x3B
let CTRL7        = 0x3F

// WHO_AM_I's value.
let ID_LIS2DW12 = 0x44

// The SPI command byte's RW bit.
let SPI_READ = 0x80

// CTRL1: the mode field, the low-power field and the ODR field.
let CTRL1_MODE_MASK = 0x0C
let CTRL1_LP_MASK   = 0x03
let CTRL1_ODR_MASK  = 0xF0
let MODE_LOW_POWER  = 0
let MODE_HIGH_PERF  = 1
let MODE_ON_DEMAND  = 2
// CTRL2: boot, soft reset, block data update and the address increment.
let CTRL2_BOOT       = 0x80
let CTRL2_SOFT_RESET = 0x40
let CTRL2_BDU        = 0x08
let CTRL2_IF_ADD_INC = 0x04
// CTRL3: the self-test field, the interrupt pad bits and the single
// conversion bits.
let CTRL3_ST_MASK = 0xC0
let CTRL3_ST_POS  = 0x40
let CTRL3_ST_NEG  = 0x80
let CTRL3_PP_OD   = 0x20
let CTRL3_LIR     = 0x10
let CTRL3_LACTIVE = 0x08
let CTRL3_SLP_SEL = 0x02
let CTRL3_SLP_1   = 0x01
// CTRL4_INT1_PAD_CTRL: the data-ready and the FIFO threshold on INT1.
let INT1_DRDY = 0x01
let INT1_FTH  = 0x02
// CTRL6: the bandwidth, the full scale and the low-noise bit.
let CTRL6_BW_MASK   = 0xC0
let CTRL6_FS_MASK   = 0x30
let CTRL6_LOW_NOISE = 0x04
// STATUS: a new sample of all three axes.
let STATUS_DRDY = 0x01
// FIFO_CTRL: continuous mode (FMode 110), the mode that overwrites the
// oldest sample.  FIFO_SAMPLES: the 6-bit count.
let FIFO_CONTINUOUS = 0xC0
let FIFO_DIFF       = 0x3F
// The most samples the FIFO holds.
let FIFO_DEPTH = 32
// WAKE_UP_THS and WAKE_UP_DUR fields.
let WU_THS_MASK       = 0x3F
let WU_SLEEP_ON       = 0x40
let WU_SINGLE_DOUBLE  = 0x80
let WU_DUR_MASK       = 0x60
let WU_SLEEP_DUR_MASK = 0x1F
let WU_FF_DUR5        = 0x80
// CTRL7: the pulsed data-ready and the interrupt enable.
let CTRL7_DRDY_PULSED = 0x80
let CTRL7_INT_ENABLE  = 0x20

// The ODR code of the default rate `start` sets, 100 Hz, and of the
// software-triggered conversion (ST's driver uses 12.5 Hz).
let ODR_100  = 5
let ODR_12_5 = 2

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ   = 400000
let SPI_HZ   = 4000000
let SPI_MODE = 3

// The most polls of a flag one wait makes.  A soft reset or a boot takes
// well under a millisecond and a poll over I2C about 100 us; a sample at
// 50 Hz takes 20 ms; a conversion on demand takes at most 3.55 ms.
let RESET_POLLS   = 100
let SAMPLE_POLLS  = 4000
let CONVERT_POLLS = 400

// The self-test limits of Table 3 in milli-g, for the positive difference.
let ST_MIN_MG = 70
let ST_MAX_MG = 1500

// The operating mode of the part (§ 3.2.1, Table 30).
pub @value
enum Lis2dwMode
    Lis2dwLowPower
    Lis2dwHighPerf
    Lis2dwOnDemand

// The events a tap detector watches and how it times them (§ 8.20 to 8.23).
// The thresholds are 5-bit fields in the data sheet's units, which scale
// with the full scale; the periods count sample periods.
pub @value
struct TapConfig
    thr_x: Int
    thr_y: Int
    thr_z: Int
    prior: Int
    x_en: Bool
    y_en: Bool
    z_en: Bool
    double_tap: Bool
    latency: Int
    quiet: Int
    shock: Int

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the interrupt pin.
pub trait Lis2dw12Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]

// ── The two buses ────────────────────────────────────────────────────

// The command byte that goes out for a read from `reg` on SPI: RW set.  A
// burst advances only while IF_ADD_INC is set.
fn spi_cmd_of(reg: Int) -> Int
    SPI_READ | (reg & 0x7F)

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the sub-address and a repeated start: whether the part
// answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg & 0x7F, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg & 0x7F, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction:
// whether it ran, which is whether the wiring has a chip select.  An
// absent part reads 0xFF, which the callers check for.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int, n: Int,
                                            var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push(spi_cmd_of(reg) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, RW clear:
// whether it ran.  The part answers nothing to a write.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x7F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the interrupt pin an input, the bus at 400
// kHz.  The wiring needs an address, which the answer says.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin
// never drives low and the part stays on the bus it was reset on, then
// an output; the interrupt pin an input; the bus at 4 MHz in mode 3.
// Answers whether the wiring has a chip select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's INT1 line on the board, 1 or 0, or -1 for a
// wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Lis2dw12Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  A register with a bit that clears itself is written
// with `write_reg`.
pub fn reg_write<P: Lis2dw12Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `bits`, leaving the
// others: whether the part took it.
//
// Fix kept: the `lis2dw12` crate writes its low-noise bit into CTRL1, where
// bit 2 is MODE0, so "low noise" switches the part to High-Performance Mode;
// the bit is CTRL6's (§ 8.9).  Every setting here changes its own bits of
// the register read from the part.
pub fn reg_update<P: Lis2dw12Port>(p: P, reg: Int, mask: Int, bits: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (bits & mask))

// The bits of a register with `bit` set when `on`.
fn flag(on: Bool, bit: Int) -> Int
    if on
        return bit
    0

// `v` held to the range `lo` to `hi`.
fn clamp(v: Int, lo: Int, hi: Int) -> Int
    if v < lo
        return lo
    if v > hi
        return hi
    v

// ── Identity ─────────────────────────────────────────────────────────

// WHO_AM_I as a `DeviceId`, or `None` when no part answers: the byte
// reads 0xFF on an SPI bus no part drives and 0x00 on one held low.
pub fn id_read<P: Lis2dw12Port>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, WHO_AM_I) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// ── Conversions ──────────────────────────────────────────────────────

// The range a CTRL6 byte's FS bits select.
pub fn range_of_ctrl6(v: Int) -> AccelRange
    match (v >> 4) & 3
        0 => AccelRange2g
        1 => AccelRange4g
        2 => AccelRange8g
        _ => AccelRange16g

// The FS bits for a range.
pub fn fs_of_range(r: AccelRange) -> Int
    match r
        AccelRange2g  => 0
        AccelRange4g  => 1
        AccelRange8g  => 2
        AccelRange16g => 3

// The mode a CTRL1 byte selects.  MODE 11 is not a mode the sheet defines;
// the driver reads it as low-power.
pub fn mode_of_ctrl1(v: Int) -> Lis2dwMode
    match (v >> 2) & 3
        1 => Lis2dwHighPerf
        2 => Lis2dwOnDemand
        _ => Lis2dwLowPower

// The MODE field for a mode.
pub fn mode_bits(m: Lis2dwMode) -> Int
    match m
        Lis2dwLowPower => MODE_LOW_POWER
        Lis2dwHighPerf => MODE_HIGH_PERF
        Lis2dwOnDemand => MODE_ON_DEMAND

// The low-power level, 1 to 4, a CTRL1 byte selects (LP_MODE plus one).
pub fn lp_level_of_ctrl1(v: Int) -> Int
    (v & CTRL1_LP_MASK) + 1

// How many bits of a word are valid for a CTRL1 byte: 14 in
// High-Performance Mode, and in the other modes 12 for Low-Power Mode 1 and
// 14 for Modes 2 to 4 (Table 30 and Table 31).
pub fn bits_of_ctrl1(v: Int) -> Int
    if ((v >> 2) & 3) == MODE_HIGH_PERF
        return 14
    if (v & CTRL1_LP_MASK) == 0
        return 12
    14

// The step of one digit in micro-g: Table 3's 0.244, 0.488, 0.976 and
// 1.952 mg for 14 bits, four times that for 12 bits.
pub fn ug_per_digit(r: AccelRange, bits: Int) -> Int
    let base = match r
        AccelRange2g  => 244
        AccelRange4g  => 488
        AccelRange8g  => 976
        AccelRange16g => 1952
    if bits == 12
        return base * 4
    base

// The rate in millihertz a CTRL1 byte selects: 0 when the part is powered
// down or the code is reserved.  The codes mean other rates in
// High-Performance Mode and in the others (Table 29).
pub fn rate_mhz_of(ctrl1: Int) -> Int
    let odr = (ctrl1 >> 4) & 15
    if ((ctrl1 >> 2) & 3) == MODE_HIGH_PERF
        return rate_hp_mhz(odr)
    rate_lp_mhz(odr)

// High-Performance Mode's rates: code 1 is 12.5 Hz, not 1.6 Hz.
fn rate_hp_mhz(odr: Int) -> Int
    match odr
        1 => 12500
        2 => 12500
        3 => 25000
        4 => 50000
        5 => 100000
        6 => 200000
        7 => 400000
        8 => 800000
        9 => 1600000
        _ => 0

// The low-power modes' rates: code 1 is 1.6 Hz, and 400 Hz and up are 200 Hz.
fn rate_lp_mhz(odr: Int) -> Int
    match odr
        1 => 1600
        2 => 12500
        3 => 25000
        4 => 50000
        5 => 100000
        6 => 200000
        7 => 200000
        8 => 200000
        9 => 200000
        _ => 0

// The ODR code of the slowest rate at or above `hz` in High-Performance Mode
// when `hp`, or in the low-power modes, or of the fastest the mode has.
pub fn odr_for_rate(hz: Int, hp: Bool) -> Int
    let mhz = hz * 1000
    if not hp and mhz <= 1600
        return 1
    if mhz <= 12500
        return 2
    if mhz <= 25000
        return 3
    if mhz <= 50000
        return 4
    if mhz <= 100000
        return 5
    if mhz <= 200000
        return 6
    if not hp
        return 6
    if mhz <= 400000
        return 7
    if mhz <= 800000
        return 8
    9

// The turn-on time in microseconds of a conversion on demand at the low-power
// level 1 to 4 (§ 3.2.2): 1.20, 1.70, 2.30 and 3.55 ms.
pub fn t_on_us(lp_level: Int) -> Int
    match lp_level
        1 => 1200
        2 => 1700
        3 => 2300
        _ => 3550

// The milli-g of an axis whose low byte is at `i` of `b`: the 16-bit word
// shifted to its valid bits with its sign kept, times the step.
fn axis(b: DevBytes, i: Int, shift: Int, ug: Int) -> Int
    let raw = dev_bus.dev_sign_extend((b[i + 1] as Int << 8) | b[i] as Int, 16) >> shift
    raw * ug / 1000

// ── Samples ──────────────────────────────────────────────────────────

// The most recent sample, in one transaction of fourteen registers from
// CTRL1 to OUT_Z_H, so the range, the mode and the width it is converted
// with are the ones it was taken in: CTRL1 to CTRL5, CTRL6, OUT_T, STATUS,
// then the three axes.  `None` when the part did not answer.  While the FIFO
// is on, the read of OUT_X_L takes the oldest sample out of it.
pub fn sample_read<P: Lis2dw12Port>(p: P) -> ?AccelMilliG [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CTRL1, 14, var b)
        return None
    let nb = bits_of_ctrl1(b[0] as Int)
    let ug = ug_per_digit(range_of_ctrl6(b[5] as Int), nb)
    let s = 16 - nb
    Some(AccelMilliG { x: axis(b, 8, s, ug), y: axis(b, 10, s, ug), z: axis(b, 12, s, ug) })

// Whether a new sample of all three axes has completed since the last
// read: STATUS's DRDY.
pub fn sample_ready<P: Lis2dw12Port>(p: P) -> Bool [hw]
    ((reg_read(p, STATUS) ?? 0) & STATUS_DRDY) != 0

// The range the part is set to, ±2 g when it does not answer.
pub fn range_read<P: Lis2dw12Port>(p: P) -> AccelRange [hw]
    range_of_ctrl6(reg_read(p, CTRL6) ?? 0)

// Sets the range and leaves the other bits of CTRL6: whether the part took
// it.
pub fn range_write<P: Lis2dw12Port>(p: P, r: AccelRange) -> Bool [hw]
    reg_update(p, CTRL6, CTRL6_FS_MASK, fs_of_range(r) << 4)

// The rate the part samples at in millihertz, 0 when it is powered down or
// does not answer.
pub fn rate_mhz_read<P: Lis2dw12Port>(p: P) -> Int [hw]
    rate_mhz_of(reg_read(p, CTRL1) ?? 0)

// Sets the slowest rate at or above `hz` in the part's present mode and
// leaves the mode and the low-power level: the rate the part took in
// millihertz, or 0 when it did not take it.  A rate set on a part in power-
// down starts it.  In High-Performance Mode with the bandwidth at ODR/2 the
// first sample at a rate of 100 Hz and up is to be discarded (Table 13).
pub fn rate_write<P: Lis2dw12Port>(p: P, hz: Int) -> Int [hw]
    let Some(old) = reg_read(p, CTRL1) else return 0
    let hp = ((old >> 2) & 3) == MODE_HIGH_PERF
    let v = (odr_for_rate(hz, hp) << 4) | (old & 0x0F)
    if not reg_write(p, CTRL1, v)
        return 0
    rate_mhz_of(v)

// The mode the part is in, low-power when it does not answer.
pub fn mode_read<P: Lis2dw12Port>(p: P) -> Lis2dwMode [hw]
    mode_of_ctrl1(reg_read(p, CTRL1) ?? 0)

// The low-power level, 1 to 4, the part is set to.
pub fn lp_level_read<P: Lis2dw12Port>(p: P) -> Int [hw]
    lp_level_of_ctrl1(reg_read(p, CTRL1) ?? 0)

// The width of a word in bits, 12 or 14, in the part's present settings.
pub fn resolution_read<P: Lis2dw12Port>(p: P) -> Int [hw]
    bits_of_ctrl1(reg_read(p, CTRL1) ?? 0)

// Sets the mode and the low-power level 1 to 4 (held to that range) and
// leaves the rate: whether the part took it.  The level is the part's
// LP_MODE plus one; Level 1 gives 12 bits and the others 14.
pub fn mode_write<P: Lis2dw12Port>(p: P, m: Lis2dwMode, lp_level: Int) -> Bool [hw]
    reg_update(p, CTRL1, CTRL1_MODE_MASK | CTRL1_LP_MASK, (mode_bits(m) << 2) | (clamp(lp_level, 1, 4) - 1))

// Turns the low-noise setting on or off: whether the part took it.
pub fn low_noise_write<P: Lis2dw12Port>(p: P, on: Bool) -> Bool [hw]
    reg_update(p, CTRL6, CTRL6_LOW_NOISE, flag(on, CTRL6_LOW_NOISE))

// Whether the low-noise setting is on.
pub fn low_noise_read<P: Lis2dw12Port>(p: P) -> Bool [hw]
    ((reg_read(p, CTRL6) ?? 0) & CTRL6_LOW_NOISE) != 0

// Sets the bandwidth of the digital filter, 0 to 3 for ODR/2, ODR/4, ODR/10
// and ODR/20 (Table 41): whether the part took it.
pub fn bandwidth_write<P: Lis2dw12Port>(p: P, code: Int) -> Bool [hw]
    reg_update(p, CTRL6, CTRL6_BW_MASK, clamp(code, 0, 3) << 6)

// ── The temperature ──────────────────────────────────────────────────

// The die temperature in milli-degrees Celsius, from OUT_T_L and OUT_T_H:
// a 12-bit word left-justified, 16 LSB per degree, 0 at 25 °C (§ 8.1,
// Table 5, whose offset is ±15 °C).  `None` when the part did not answer.
pub fn temp_read_milli_c<P: Lis2dw12Port>(p: P) -> ?TempMilliC [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUT_T_L, 2, var b)
        return None
    let word = (b[1] as Int << 8) | b[0] as Int
    let t = dev_thermo.temp_of_raw(word >> 4, 12, 62500)
    Some(TempMilliC { milli_c: t.milli_c + 25000 })

// Starts a temperature conversion, which the part does not need: it
// converts at its sample rate.  Answers 0, or -1 when the part is powered
// down or does not answer, since it then keeps the last result.
pub fn temp_begin<P: Lis2dw12Port>(p: P) -> Int [hw]
    if rate_mhz_of(reg_read(p, CTRL1) ?? 0) == 0
        return -1
    0

// ── The FIFO ─────────────────────────────────────────────────────────
//
// The FIFO holds 32 samples of three axes (§ 5.3).  It is off after
// `start`; `fifo_start` turns it on in continuous mode, which overwrites the
// oldest sample when it is full, and `fifo_stop` turns it off.  While it is
// on, a read of OUT_X_L takes the oldest sample out.  The first sample
// after a switch into or out of the FIFO is to be discarded (§ 5.3).

// Turns the FIFO on in continuous mode with the threshold at `threshold`
// samples, 1 to 31, and puts the threshold flag, not the data-ready, on
// INT1: whether the part took every setting.
pub fn fifo_start<P: Lis2dw12Port>(p: P, threshold: Int) -> Bool [hw]
    reg_write(p, FIFO_CTRL, FIFO_CONTINUOUS | clamp(threshold, 1, 31)) and reg_write(p, CTRL4_INT1, INT1_FTH)

// Turns the FIFO off and puts the data-ready back on INT1: whether the part
// took every setting.  Bypass mode empties the FIFO.
pub fn fifo_stop<P: Lis2dw12Port>(p: P) -> Bool [hw]
    reg_write(p, FIFO_CTRL, 0) and reg_write(p, CTRL4_INT1, INT1_DRDY)

// The number of samples in the FIFO, 0 to 32; 0 when the part did not
// answer.  FIFO_SAMPLES counts in six bits, so a full FIFO reads 32.
pub fn fifo_count<P: Lis2dw12Port>(p: P) -> Int [hw]
    (reg_read(p, FIFO_SAMPLES) ?? 0) & FIFO_DIFF

// Moves the samples of the FIFO, oldest first, into `dst`, which is
// emptied first, and answers how many it moved.  The count is read once and
// each sample is one burst of the fourteen registers `sample_read` reads, so
// each is converted with the settings it is read in.
pub fn fifo_read<P: Lis2dw12Port>(p: P, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
    dst.clear()
    let n = fifo_count(p)
    var moved = 0
    for _i in 0..n
        let Some(s) = sample_read(p) else return moved
        let _ = dst.push(s)
        moved = moved + 1
    moved

// ── Conversion on demand ─────────────────────────────────────────────
//
// In the single-conversion mode (§ 3.2.2) the part measures once when
// triggered, stores the sample, and goes back to power-down; the DRDY line
// and the flag say the sample is there.  The trigger is a write to CTRL3's
// SLP_MODE_1 with SLP_MODE_SEL set (Rev 8's text), or a clock on INT2.
//
// Open question, NOT VERIFIED: ST's `lis2dw12-pid` driver spells the
// software trigger as SLP_MODE_1 alone (its constant 0x12 sets CTRL3's bit 0
// and leaves bit 1 clear) and the pin trigger as SLP_MODE_SEL alone (0x22),
// which is the opposite of Rev 8's text.  The two constants below are the
// text's, and they are the one place to change if a part says otherwise.

// Puts the part in the single-conversion mode at the low-power level it has,
// with the software trigger selected: whether the part took it.  It sets
// the ODR code ST's driver uses with the mode, 12.5 Hz.
pub fn single_arm<P: Lis2dw12Port>(p: P) -> Bool [hw]
    reg_update(p, CTRL3, CTRL3_SLP_SEL, CTRL3_SLP_SEL) and reg_update(p, CTRL1, CTRL1_ODR_MASK | CTRL1_MODE_MASK, (ODR_12_5 << 4) | (MODE_ON_DEMAND << 2))

// Triggers one conversion: whether the write was acknowledged.  The bit
// clears by itself when the sample is in the registers, so it is written
// without a read-back.
pub fn single_trigger<P: Lis2dw12Port>(p: P) -> Bool [hw]
    let Some(old) = reg_read(p, CTRL3) else return false
    p.write_reg(CTRL3, old | CTRL3_SLP_SEL | CTRL3_SLP_1)

// Whether the last trigger's conversion has finished: SLP_MODE_1 is clear.
pub fn single_done<P: Lis2dw12Port>(p: P) -> Bool [hw]
    ((reg_read(p, CTRL3) ?? CTRL3_SLP_1) & CTRL3_SLP_1) == 0

// One conversion on demand: triggers it, polls until it has finished, and
// answers the sample, or `None` when the trigger was not acknowledged or the
// conversion did not finish.
pub fn convert_once<P: Lis2dw12Port>(p: P) -> ?AccelMilliG [hw]
    if not single_trigger(p)
        return None
    for _i in 0..CONVERT_POLLS
        if single_done(p)
            return sample_read(p)
    None

// ── Waiting on a host's scheduler ────────────────────────────────────
//
// The functions below are `@tier(rt)` because the package checks at the
// embedded tier, which refuses an `async fn` that is not bounded.  They wait
// on a `TimerAsync` the caller gives, since a driver value is `@value` and
// an `async fn` takes none (SPEC § 14.5): `AccelerometerAsync` cannot be
// implemented by `Lis2dw12`.  A program at `@tier(embedded)` arms the INT1
// line through `irq_arm` and the board's `AsyncEdge` instead.

// Triggers one conversion on demand, parks the task for the turn-on time
// and answers the sample: `None` when the trigger was not acknowledged or the
// part is not finished after four turn-on times.
pub @tier(rt)
async fn accel_measure<P: Lis2dw12Port, T: TimerAsync>(p: P, t: T) -> ?AccelMilliG [hw, async]
    if not single_trigger(p)
        return None
    let wait = t_on_us(lp_level_read(p))
    for _i in 0..4
        await t.sleep_us(wait)
        if single_done(p)
            return sample_read(p)
    None

// Parks the task until the next sample is complete and answers it: the
// data-ready flag is polled every `period_us`, at most `tries` times.
pub @tier(rt)
async fn accel_next<P: Lis2dw12Port, T: TimerAsync>(p: P, t: T, period_us: Int,
                                                    tries: Int) -> ?AccelMilliG [hw, async]
    for _i in 0..tries
        if sample_ready(p)
            return sample_read(p)
        await t.sleep_us(period_us)
    None

// Arms the part's INT1 line on a rising edge through a board's pin-edge
// source: 0 when armed, a negative value when refused, and -1 for a wiring
// with no interrupt pin.  The data-ready or the threshold event that INT1
// carries resolves `f`.
pub fn irq_arm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring, f: Future) -> Int [e]
    let Some(irq) = w.irq else return -1
    edge.edge_arm(irq, 0, f)

// Takes the arm back: whether it was still armed.  False for a wiring with
// no interrupt pin.
pub fn irq_disarm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring) -> Bool [e]
    let Some(irq) = w.irq else return false
    edge.edge_disarm(irq)

// ── Self-test ────────────────────────────────────────────────────────

// Waits for the next sample by polling STATUS's DRDY, at most
// `SAMPLE_POLLS` times: whether one came.
fn wait_sample<P: Lis2dw12Port>(p: P) -> Bool [hw]
    for _i in 0..SAMPLE_POLLS
        if sample_ready(p)
            return true
    false

// Two samples, the first discarded because the output settles over the
// first period, and the second answered.
fn settled_sample<P: Lis2dw12Port>(p: P) -> ?AccelMilliG [hw]
    if not wait_sample(p)
        return None
    let _first = sample_read(p)
    if not wait_sample(p)
        return None
    sample_read(p)

// The change the part's self-test makes to its outputs (§ 3.2.3): the
// part at ±4 g in High-Performance Mode at 50 Hz is read with ST clear and
// again with the positive sign (ST 01) or the negative sign (ST 10,
// `negative` true), and the answer is the second reading minus the first,
// in milli-g.  The settings the part had are put back.  `None` when the part
// did not answer or a sample did not come.  Table 3 gives the positive
// difference as 70 to 1500 mg; `self_test_ok` checks a change against it.
pub fn self_test_delta<P: Lis2dw12Port>(p: P, negative: Bool) -> ?AccelMilliG [hw]
    let Some(c1) = reg_read(p, CTRL1) else return None
    let Some(c3) = reg_read(p, CTRL3) else return None
    let Some(c6) = reg_read(p, CTRL6) else return None
    var st = CTRL3_ST_POS
    if negative
        st = CTRL3_ST_NEG
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_write(p, CTRL1, 0) and reg_write(p, CTRL6, fs_of_range(AccelRange4g) << 4) and reg_write(p, CTRL3, c3 & (0xFF ^ CTRL3_ST_MASK)) and reg_write(p, CTRL1, (4 << 4) | (MODE_HIGH_PERF << 2))
        if let Some(off) = settled_sample(p)
            if reg_write(p, CTRL3, (c3 & (0xFF ^ CTRL3_ST_MASK)) | st)
                if let Some(on) = settled_sample(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back3 = reg_write(p, CTRL3, c3 & (0xFF ^ CTRL3_ST_MASK))
    let _back6 = reg_write(p, CTRL6, c6)
    let _back1 = reg_write(p, CTRL1, c1)
    if not ok
        return None
    Some(AccelMilliG { x: dx, y: dy, z: dz })

// Whether the self-test change `d` is within Table 3's limits on every
// axis, 70 to 1500 mg in magnitude.
pub fn self_test_ok(d: AccelMilliG) -> Bool
    self_test_within(d, ST_MIN_MG, ST_MAX_MG)

// Whether every axis of the self-test change `d` is at least `lo` and at
// most `hi` in magnitude, in milli-g.
pub fn self_test_within(d: AccelMilliG, lo: Int, hi: Int) -> Bool
    abs_in(d.x, lo, hi) and abs_in(d.y, lo, hi) and abs_in(d.z, lo, hi)

// Whether the magnitude of `v` is within `lo` to `hi`.
fn abs_in(v: Int, lo: Int, hi: Int) -> Bool
    var a = v
    if a < 0
        a = 0 - a
    a >= lo and a <= hi

// ── Event detectors and interrupt routing ────────────────────────────
//
// The wake-up, activity, tap, free-fall and orientation detectors are
// configuration: the functions set the registers, `interrupts_enable` turns
// the detectors on, and `int1_route` and `int2_route` choose the events on
// the pins (Tables 36 and 38).  Thresholds of the tap and free-fall
// detectors are the data sheet's own fields; the wake-up threshold is given
// in milli-g because the sheet gives its weight, 1/64 of the full scale.

// Routes the events of `bits` to INT1, replacing the routing: 0x01 data
// ready, 0x02 FIFO threshold, 0x04 FIFO full, 0x08 double tap, 0x10 free
// fall, 0x20 wake-up, 0x40 single tap, 0x80 6D.  Whether the part took it.
pub fn int1_route<P: Lis2dw12Port>(p: P, bits: Int) -> Bool [hw]
    reg_write(p, CTRL4_INT1, bits)

// Routes the events of `bits` to INT2, replacing the routing: 0x01 data
// ready, 0x02 FIFO threshold, 0x04 FIFO full, 0x08 FIFO overrun, 0x10
// temperature data ready, 0x20 boot, 0x40 sleep change, 0x80 sleep state.
pub fn int2_route<P: Lis2dw12Port>(p: P, bits: Int) -> Bool [hw]
    reg_write(p, CTRL5_INT2, bits)

// Turns the detectors on or off (CTRL7's INTERRUPTS_ENABLE).
pub fn interrupts_enable<P: Lis2dw12Port>(p: P, on: Bool) -> Bool [hw]
    reg_update(p, CTRL7, CTRL7_INT_ENABLE, flag(on, CTRL7_INT_ENABLE))

// The pins' electrical form: active low, open drain, and latched events
// (CTRL3).  A latched event stays on the pin until its source register is
// read.
pub fn int_pins<P: Lis2dw12Port>(p: P, active_low: Bool, open_drain: Bool,
                                 latched: Bool) -> Bool [hw]
    reg_update(p,
        CTRL3,
        CTRL3_LACTIVE | CTRL3_PP_OD | CTRL3_LIR,
        flag(active_low, CTRL3_LACTIVE) | flag(open_drain, CTRL3_PP_OD) | flag(latched, CTRL3_LIR))

// Makes the data-ready line a pulse instead of a level held until the
// output registers are read (CTRL7's DRDY_PULSED).  Zephyr's driver keeps
// this a setting of its own, since a latched line that is not read stays
// high and hides the next sample.
pub fn drdy_pulsed<P: Lis2dw12Port>(p: P, on: Bool) -> Bool [hw]
    reg_update(p, CTRL7, CTRL7_DRDY_PULSED, flag(on, CTRL7_DRDY_PULSED))

// The wake-up threshold code for `thr_mg` milli-g at range `r`: 1/64 of the
// full scale per step, held to 1 to 63, since 0 would fire at once.
pub fn wake_up_code(thr_mg: Int, r: AccelRange) -> Int
    clamp(thr_mg * 64 / dev_accel.accel_full_scale(r), 1, 63)

// The milli-g a wake-up threshold code means at range `r`.
pub fn wake_up_mg(code: Int, r: AccelRange) -> Int
    code * dev_accel.accel_full_scale(r) / 64

// Sets the wake-up threshold in milli-g at the present range and the
// duration in sample periods, 0 to 3 (§ 8.24, 8.25): whether the part took
// it.  The threshold follows the range, so it is set again after a change of
// range.
pub fn wake_up_config<P: Lis2dw12Port>(p: P, thr_mg: Int, dur: Int) -> Bool [hw]
    reg_update(p, WAKE_UP_THS, WU_THS_MASK, wake_up_code(thr_mg, range_read(p))) and reg_update(p, WAKE_UP_DUR, WU_DUR_MASK, clamp(dur, 0, 3) << 5)

// Sets the activity and inactivity detection: `sleep_on` turns on the
// change to 12.5 Hz when the part is still, `stationary` the detection that
// leaves the rate alone, and `sleep_dur` is the time to be still, 0 to 15 in
// steps of 512 sample periods (§ 3.2.4, 8.25).  Whether the part took it.
pub fn activity_config<P: Lis2dw12Port>(p: P, sleep_on: Bool, stationary: Bool,
                                        sleep_dur: Int) -> Bool [hw]
    reg_update(p, WAKE_UP_THS, WU_SLEEP_ON, flag(sleep_on, WU_SLEEP_ON)) and reg_update(p, WAKE_UP_DUR, WU_SLEEP_DUR_MASK, flag(stationary, 0x10) | clamp(sleep_dur, 0, 15))

// Sets the tap detector from `c` (§ 3.2.5, 8.20 to 8.23, 8.24): whether the
// part took every register.
pub fn tap_config<P: Lis2dw12Port>(p: P, c: TapConfig) -> Bool [hw]
    let axes = flag(c.x_en, 0x80) | flag(c.y_en, 0x40) | flag(c.z_en, 0x20)
    let dur = (clamp(c.latency, 0, 15) << 4) | (clamp(c.quiet, 0, 3) << 2) | clamp(c.shock, 0, 3)
    reg_update(p, TAP_THS_X, 0x1F, clamp(c.thr_x, 0, 31)) and reg_write(p, TAP_THS_Y, (clamp(c.prior, 0, 7) << 5) | clamp(c.thr_y, 0, 31)) and reg_write(p, TAP_THS_Z, axes | clamp(c.thr_z, 0, 31)) and reg_write(p, INT_DUR, dur) and reg_update(p, WAKE_UP_THS, WU_SINGLE_DOUBLE, flag(c.double_tap, WU_SINGLE_DOUBLE))

// The free-fall threshold of code 0 to 7 in the data sheet's units for ±2 g
// (Table 74): 5, 7, 8, 10, 11, 13, 15 and 16.
pub fn free_fall_lsb(code: Int) -> Int
    match clamp(code, 0, 7)
        0 => 5
        1 => 7
        2 => 8
        3 => 10
        4 => 11
        5 => 13
        6 => 15
        _ => 16

// Sets the free-fall detector: the threshold code 0 to 7 and the duration
// in sample periods, 0 to 63, whose sixth bit lives in WAKE_UP_DUR (§ 8.25,
// 8.26).  Whether the part took it.
pub fn free_fall_config<P: Lis2dw12Port>(p: P, code: Int, dur: Int) -> Bool [hw]
    let d = clamp(dur, 0, 63)
    reg_write(p, FREE_FALL, ((d & 0x1F) << 3) | clamp(code, 0, 7)) and reg_update(p, WAKE_UP_DUR, WU_FF_DUR5, (d >> 5) << 7)

// Sets the orientation detector: `four_d` limits it to portrait and landscape
// with face-up and face-down, and `code` 0 to 3 is the threshold of 80, 70,
// 60 or 50 degrees (Table 60).  Whether the part took it.
pub fn orientation_config<P: Lis2dw12Port>(p: P, four_d: Bool, code: Int) -> Bool [hw]
    reg_update(p, TAP_THS_X, 0xE0, flag(four_d, 0x80) | (clamp(code, 0, 3) << 5))

// The tap source register: the sign and the axes of the last tap.  Reading
// it clears a latched event.
pub fn tap_source<P: Lis2dw12Port>(p: P) -> Int [hw]
    reg_read(p, TAP_SRC) ?? 0

// The wake-up source register.
pub fn wake_up_source<P: Lis2dw12Port>(p: P) -> Int [hw]
    reg_read(p, WAKE_UP_SRC) ?? 0

// The 6D source register: the orientation, one bit for each face.
pub fn orientation_source<P: Lis2dw12Port>(p: P) -> Int [hw]
    reg_read(p, SIXD_SRC) ?? 0

// The all-events register; reading it clears every latched event at once.
pub fn event_source<P: Lis2dw12Port>(p: P) -> Int [hw]
    reg_read(p, ALL_INT_SRC) ?? 0

// ── Bring-up ─────────────────────────────────────────────────────────

// Waits for a self-clearing bit of CTRL2 to clear, at most `RESET_POLLS`
// reads: whether it did.
fn wait_ctrl2_clear<P: Lis2dw12Port>(p: P, bit: Int) -> Bool [hw]
    for _i in 0..RESET_POLLS
        let Some(v) = reg_read(p, CTRL2) else return false
        if (v & bit) == 0
            return true
    false

// Resets every control register to its reset value with CTRL2's SOFT_RESET
// and waits for the bit to clear: whether it did.
//
// Fix kept: Zephyr's driver writes SOFT_RESET and waits a fixed 100 us; the
// bit clears itself, so the wait here is a poll of the bit and no time is
// assumed.  The bit is written without a read-back.
pub fn soft_reset<P: Lis2dw12Port>(p: P) -> Bool [hw]
    if not p.write_reg(CTRL2, CTRL2_SOFT_RESET)
        return false
    wait_ctrl2_clear(p, CTRL2_SOFT_RESET)

// Reloads the factory trimming from the non-volatile memory with CTRL2's
// BOOT, which a stray write to a trim register needs (§ 3.5), and waits for
// the bit to clear: whether it did.  The control registers are not touched.
pub fn reboot<P: Lis2dw12Port>(p: P) -> Bool [hw]
    let Some(old) = reg_read(p, CTRL2) else return false
    if not p.write_reg(CTRL2, old | CTRL2_BOOT)
        return false
    wait_ctrl2_clear(p, CTRL2_BOOT)

// Brings the part up: the bus made ready; WHO_AM_I checked; a soft reset, so
// that the registers are in a known state (the part keeps them while
// powered); then block data update and the address increment, the INT1 line
// carrying the data-ready, and High-Performance Mode at ±2 g, 100 Hz, 14
// bits, the filter at ODR/2.  CTRL1 is written last, so the part starts
// measuring with every other setting in place.  Answers whether the part
// answered as a LIS2DW12 and took every setting.  The caller has waited for
// the part to turn on after power-up.
pub fn start<P: Lis2dw12Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if reg_read(p, WHO_AM_I) != Some(ID_LIS2DW12)
        return false
    if not soft_reset(p)
        return false
    reg_write(p, CTRL2, CTRL2_BDU | CTRL2_IF_ADD_INC) and reg_write(p, CTRL3, 0) and reg_write(p, CTRL4_INT1, INT1_DRDY) and reg_write(p, CTRL5_INT2, 0) and reg_write(p, CTRL6, 0) and reg_write(p, CTRL7, 0) and reg_write(p, FIFO_CTRL, 0) and reg_write(p, CTRL1, (ODR_100 << 4) | (MODE_HIGH_PERF << 2))

// ── The part on an I2C bus ───────────────────────────────────────────

// A LIS2DW12 on a board's I2C bus at the address `w.addr`, 0x18 or 0x19,
// with the board's GPIO for the interrupt line.
pub @value
struct Lis2dw12
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Lis2dw12Port for Lis2dw12
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Lis2dw12
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Lis2dw12
        Lis2dw12 { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The operating mode.
    fn mode(self) -> Lis2dwMode [hw]
        mode_read(self)

    // The low-power level, 1 to 4.
    fn lp_level(self) -> Int [hw]
        lp_level_read(self)

    // The width of a word, 12 or 14 bits.
    fn resolution(self) -> Int [hw]
        resolution_read(self)

    // Sets the mode and the low-power level (`mode_write`).
    fn set_mode(self, m: Lis2dwMode, lp_level: Int) -> Bool [hw]
        mode_write(self, m, lp_level)

    // Turns the FIFO on with the threshold at `threshold` samples.
    fn fifo_begin(self, threshold: Int) -> Bool [hw]
        fifo_start(self, threshold)

    // Turns the FIFO off.
    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    // One conversion on demand (`convert_once`).
    fn convert(self) -> ?AccelMilliG [hw]
        convert_once(self)

    // The self-test change in milli-g (`self_test_delta`).
    fn self_test(self, negative: Bool) -> ?AccelMilliG [hw]
        self_test_delta(self, negative)

impl Accelerometer[hw] for Lis2dw12
    fn accel_read(self) -> ?AccelMilliG [hw]
        sample_read(self)

    fn accel_ready(self) -> Bool [hw]
        sample_ready(self)

    fn accel_range(self) -> AccelRange [hw]
        range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        range_write(self, r)

    fn accel_rate_hz(self) -> Int [hw]
        rate_mhz_read(self) / 1000

    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        rate_write(self, hz) / 1000

    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

impl Thermometer[hw] for Lis2dw12
    fn temp_start(self) -> Int [hw]
        temp_begin(self)

    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_milli_c(self)

impl Identifiable[hw] for Lis2dw12
    // WHO_AM_I, 0x44; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The part on an SPI bus ───────────────────────────────────────────

// A LIS2DW12 on a board's SPI bus with the chip select `w.cs`, with the
// board's GPIO for the chip select and the interrupt line.
pub @value
struct Lis2dw12Spi
    bus: BoardSpi
    pins: BoardGpio
    w: DeviceWiring

impl Lis2dw12Port for Lis2dw12Spi
    fn setup(self) -> Bool [hw]
        spi_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        spi_read_into(self.bus, self.pins, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        spi_write(self.bus, self.pins, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Lis2dw12Spi
    // The part on the board's SPI bus with the chip select `w.cs`, as a
    // board's device table builds it.  Nothing is sent.
    fn attach(bus: BoardSpi, pins: BoardGpio, w: DeviceWiring) -> Lis2dw12Spi
        Lis2dw12Spi { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the wiring has no chip select.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The operating mode.
    fn mode(self) -> Lis2dwMode [hw]
        mode_read(self)

    // The low-power level, 1 to 4.
    fn lp_level(self) -> Int [hw]
        lp_level_read(self)

    // The width of a word, 12 or 14 bits.
    fn resolution(self) -> Int [hw]
        resolution_read(self)

    // Sets the mode and the low-power level (`mode_write`).
    fn set_mode(self, m: Lis2dwMode, lp_level: Int) -> Bool [hw]
        mode_write(self, m, lp_level)

    // Turns the FIFO on with the threshold at `threshold` samples.
    fn fifo_begin(self, threshold: Int) -> Bool [hw]
        fifo_start(self, threshold)

    // Turns the FIFO off.
    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    // One conversion on demand (`convert_once`).
    fn convert(self) -> ?AccelMilliG [hw]
        convert_once(self)

    // The self-test change in milli-g (`self_test_delta`).
    fn self_test(self, negative: Bool) -> ?AccelMilliG [hw]
        self_test_delta(self, negative)

impl Accelerometer[hw] for Lis2dw12Spi
    fn accel_read(self) -> ?AccelMilliG [hw]
        sample_read(self)

    fn accel_ready(self) -> Bool [hw]
        sample_ready(self)

    fn accel_range(self) -> AccelRange [hw]
        range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        range_write(self, r)

    fn accel_rate_hz(self) -> Int [hw]
        rate_mhz_read(self) / 1000

    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        rate_write(self, hz) / 1000

    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

impl Thermometer[hw] for Lis2dw12Spi
    fn temp_start(self) -> Int [hw]
        temp_begin(self)

    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_milli_c(self)

impl Identifiable[hw] for Lis2dw12Spi
    // WHO_AM_I, 0x44; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)
